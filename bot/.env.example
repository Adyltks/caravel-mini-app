# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# Куда присылать заявки: ваш личный chat id или id группы (узнать: напишите боту /id)
ADMIN_CHAT_ID=123456789
# Адрес мини аппа (GitHub Pages / Netlify)
WEBAPP_URL=https://adyltks.github.io/caravel-mini-app/
# Порт HTTP API
PORT=3000
# Откуда разрешены запросы (адрес мини аппа без слэша на конце или *)
ALLOWED_ORIGIN=*

# Google Таблица (необязательно). ID из ссылки на таблицу и JSON сервисного аккаунта одной строкой
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_TAB=Заявки

# Кто видит админ-панель в мини аппе: Telegram ID через запятую (узнать: /id боту)
ADMIN_IDS=

# Supabase (база для услуг и заявок). Без неё данные хранятся в памяти и пропадают при перезапуске.
SUPABASE_URL=https://eovecvbauhsvdbhpgays.supabase.co
# service_role ключ: Supabase → Project Settings → API Keys → service_role (секрет, никому не показывать)
SUPABASE_SERVICE_KEY=
